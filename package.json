{
  "name": "mailcheap-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "cf-typegen": "wrangler types --strict-vars=false --include-runtime=false",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:dev": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.12.0",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.0",
    "sanitize-html": "^2.18.0",
    "sonner": "^2.0.8",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
