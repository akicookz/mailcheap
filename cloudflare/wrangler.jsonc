{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailcheap-cloudflare",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "SENDING_ENABLED": "false",
    "APP_URL": "http://localhost:5179",
    "SEND_PER_SECOND": "2",
    "LOCAL_PREVIEW": "false",
    "EVENTS_QUEUE": "mailcheap-email-events",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailcheap",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "mailcheap-images" }],
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "mailcheap-send" }],
    "consumers": [
      {
        "queue": "mailcheap-send",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "mailcheap-send-failed",
      },
      {
        "queue": "mailcheap-email-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "mailcheap-events-failed",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
