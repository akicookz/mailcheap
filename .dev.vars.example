ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-at-least-16-characters
LINK_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://127.0.0.1:5179
LOCAL_PREVIEW=true
SENDING_ENABLED=false

# Optional: dashboard domain management. Use the account that runs this Worker.
# Scope the token to that account and the zones you want to manage.
# Keep the token server-side. DNS writes are blocked while LOCAL_PREVIEW=true.
# CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
# CLOUDFLARE_API_TOKEN=your-scoped-api-token

# Recommended: private Cloudflare OAuth client (server-side, client_secret_post).
# Register both authorization_code and refresh_token grants.
# Scopes: zone.read, email-sending.write (offline_access is added for refresh).
# Callback: {APP_URL}/api/admin/cloudflare/callback
# CLOUDFLARE_OAUTH_CLIENT_ID=your-client-id
# CLOUDFLARE_OAUTH_CLIENT_SECRET=your-client-secret
# LINK_SECRET encrypts the saved tokens. Changing it requires reconnecting.
